# TP14 partie 1 : installation de K3s
- name: Prérequis communs
  hosts: all
  become: true
  tasks:
    - name: Installer curl
      ansible.builtin.apt:
        name: curl
        state: present
        update_cache: true

- name: Nœud server (control plane)
  hosts: server
  become: true
  tasks:
    - name: Installer K3s en mode server (idempotent)
      ansible.builtin.shell: curl -sfL https://get.k3s.io | sh -
      args:
        creates: /usr/local/bin/k3s
      environment:
        INSTALL_K3S_EXEC: "server --node-ip {{ k3s_server_ip }} --tls-san {{ k3s_server_ip }} --write-kubeconfig-mode 644"

    - name: Lire le jeton du server
      ansible.builtin.slurp:
        src: /var/lib/rancher/k3s/server/node-token
      register: node_token_raw

    - name: Stocker le jeton dans un fait
      ansible.builtin.set_fact:
        k3s_token: "{{ node_token_raw.content | b64decode | trim }}"

    - name: Rapatrier k3s.yaml sur la VM de lab
      ansible.builtin.fetch:
        src: /etc/rancher/k3s/k3s.yaml
        dest: "{{ playbook_dir }}/k3s.yaml"
        flat: true

    - name: Remplacer 127.0.0.1 par l'IP du server
      ansible.builtin.replace:
        path: "{{ playbook_dir }}/k3s.yaml"
        regexp: 'https://127\.0\.0\.1:6443'
        replace: "https://{{ k3s_server_ip }}:6443"
      delegate_to: localhost
      become: false

- name: Nœuds agents (workers)
  hosts: agents
  become: true
  vars:
    node_ip: "{{ ansible_all_ipv4_addresses | select('match', '^192\\.168\\.56\\.') | first }}"
  tasks:
    - name: Installer K3s en mode agent (idempotent)
      ansible.builtin.shell: curl -sfL https://get.k3s.io | sh -
      args:
        creates: /usr/local/bin/k3s
      environment:
        K3S_URL: "https://{{ k3s_server_ip }}:6443"
        K3S_TOKEN: "{{ hostvars['k3s-server'].k3s_token }}"
        INSTALL_K3S_EXEC: "agent --node-ip {{ node_ip }}"
